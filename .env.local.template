# ============================================================
# Tulis Noon — Local Environment Variables Template
# ============================================================
# Copy file ini jadi .env.local, lalu isi value dari Firebase Console
# Jangan commit file .env.local ke GitHub (sudah masuk .gitignore)
# ============================================================

# === FIREBASE WEB CONFIG ===
# Ambil dari: Firebase Console → ⚙️ Project Settings → tab "General"
# → scroll ke bawah "Your apps" → klik web app (</> icon)
# → di section "SDK setup and configuration" → pilih "Config"
# → akan muncul object firebaseConfig = { apiKey: "...", ... }

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# === FIREBASE CLOUD MESSAGING (FCM) WEB PUSH ===
# Ambil dari: Firebase Console → ⚙️ Project Settings → tab "Cloud Messaging"
# → scroll ke "Web configuration" → "Web Push certificates"
# → kalau belum ada, klik "Generate key pair"
# → copy "Key pair" value

NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# === FIREBASE ADMIN SDK (Service Account JSON) ===
# Ambil dari: Firebase Console → ⚙️ Project Settings → tab "Service accounts"
# → klik tombol "Generate new private key" → file JSON akan ter-download
# → buka file JSON, copy SELURUH isinya (mulai { sampai })
# → paste di bawah sebagai SATU BARIS dengan tanda kutip tunggal di luar
# CONTOH FORMAT (ini bukan value asli):
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"tulis-noon",...}'

FIREBASE_SERVICE_ACCOUNT=

# === OPTIONAL — sudah ada default kalau dikosongkan ===
ALADHAN_API_URL=https://api.aladhan.com/v1
DEFAULT_TIMEZONE=Asia/Riyadh
PRAYER_CALCULATION_METHOD=4
CRON_SECRET=
DEBUG_PRAYER_TIMES=false
DEBUG_NOTIFICATIONS=false
